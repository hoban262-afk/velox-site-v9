# Velox Peptides — environment variables
# Copy to .env.local for local dev. Set the same vars in Vercel project settings.
# NEVER commit real values — .env.local is gitignored.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://stkjdtyhaxejxqmbzyua.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key            # public; safe in client (RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key      # SECRET — server only (loyalty functions, fena webhook)

# ── Fena Pay by Bank ──────────────────────────────────────────────────────────
FENA_CLIENT_ID=your_fena_client_id
FENA_CLIENT_SECRET=your_fena_client_secret

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://veloxpeps.com

# ── Email (existing) ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key                   # transactional order emails
GOOGLE_SHEETS_URL=your_apps_script_webhook_url        # order logging (existing)

# ── IndexNow (SEO — Bing/Yandex instant submission) ───────────────────────────
INDEXNOW_KEY=a4cf036e4e0666c870ccabf4b5546567        # must match the file served at /<key>.txt (output/<key>.txt)

# ── Checkout recovery (new) ───────────────────────────────────────────────────
CRON_SECRET=generate_a_long_random_string            # Vercel Cron sends this as a Bearer token to /api/recovery/run
# INTERNAL_TASK_SECRET is also accepted by /api/recovery/run for manual triggers
# (it already exists in your Vercel env — used by fena-webhook to fire Click & Drop).

# Notes:
# - The account system uses Supabase Auth (no custom JWT/bcrypt env vars needed).
# - Password-reset emails are sent by Supabase Auth. To route them through
#   Resend, configure Supabase Auth SMTP in the dashboard (optional).
# - The browser uses only SUPABASE_URL + the anon key (hardcoded in
#   assets/js/supabase-client.js). The service-role key is used only by
#   serverless functions in /api and must never reach the client.
