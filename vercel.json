{
  "buildCommand": "node scripts/sync-prices.mjs && node scripts/sync-stock.mjs",
  "trailingSlash": true,
  "functions": {
    "api/design-lab/[action].js": { "maxDuration": 60 },
    "api/send-order.js": { "maxDuration": 30 },
    "api/admin/marketing.js": { "maxDuration": 60 },
    "api/agents/health-monitor.js": { "maxDuration": 90 }
  },
  "crons": [
    {
      "path": "/api/recovery/run/",
      "schedule": "2-57/5 * * * *"
    },
    {
      "path": "/api/recovery/sub-fulfil-run/",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/recovery/reorder-run/",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/recovery/welcome-run/",
      "schedule": "11 * * * *"
    },
    {
      "path": "/api/recovery/restock-run/",
      "schedule": "14-59/15 * * * *"
    },
    {
      "path": "/api/recovery/review-run/",
      "schedule": "10 11 * * *"
    },
    {
      "path": "/api/recovery/design-nurture-run/",
      "schedule": "21 * * * *"
    },
    {
      "path": "/api/recovery/affiliate-commission-run/",
      "schedule": "51 * * * *"
    },
    {
      "path": "/api/admin/insights-run/",
      "schedule": "20 8 * * 1"
    },
    {
      "path": "/api/analytics/gsc-run/",
      "schedule": "25 6 * * *"
    },
    {
      "path": "/api/analytics/ga-run/",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/agents/reorder-check/",
      "schedule": "10 9 * * *"
    },
    {
      "path": "/api/pack/sync/",
      "schedule": "6-56/10 * * * *"
    },
    {
      "path": "/api/agents/run-approved/",
      "schedule": "3-53/10 * * * *"
    },
    {
      "path": "/api/agents/support-autoreply/",
      "schedule": "8-58/10 * * * *"
    },
    {
      "path": "/api/agents/daily-briefing/",
      "schedule": "35 7 * * *"
    },
    {
      "path": "/api/agents/weekly-finance/",
      "schedule": "45 9 * * 1"
    },
    {
      "path": "/api/agents/compliance-audit/",
      "schedule": "50 7 * * 0"
    },
    {
      "path": "/api/agents/health-monitor/",
      "schedule": "4-49/15 * * * *"
    },
    {
      "path": "/api/agents/backup-run/",
      "schedule": "20 5 * * 1"
    },
    {
      "path": "/api/agents/anomaly-watch/",
      "schedule": "35 10 * * *"
    },
    {
      "path": "/api/agents/content-draft/",
      "schedule": "25 8 1 * *"
    },
    {
      "path": "/api/indexnow/",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/deal-rotate/",
      "schedule": "41 * * * *"
    },
    {
      "path": "/api/agents/chat-transcripts/?mode=flush",
      "schedule": "9-54/15 * * * *"
    },
    {
      "path": "/api/agents/chat-transcripts/?mode=digest",
      "schedule": "55 7 * * *"
    }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
    ] },
    { "source": "/assets/(.*)\\.(woff2|woff|ttf|otf)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|gif|ico|avif)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/gmail/:action",        "destination": "/api/gmail/[action]" },
    { "source": "/api/gmail/:action/",       "destination": "/api/gmail/[action]" },
    { "source": "/api/clickdrop/:action",    "destination": "/api/clickdrop/[action]" },
    { "source": "/api/clickdrop/:action/",   "destination": "/api/clickdrop/[action]" },
    { "source": "/api/xero/:action",         "destination": "/api/xero/[action]" },
    { "source": "/api/xero/:action/",        "destination": "/api/xero/[action]" },
    { "source": "/api/design-lab/:action",   "destination": "/api/design-lab/[action]" },
    { "source": "/api/design-lab/:action/",  "destination": "/api/design-lab/[action]" },
    { "source": "/api/pack/:action(auth|dispatch|label|queue|receive|variants)",  "destination": "/api/pack/[action]" },
    { "source": "/api/pack/:action(auth|dispatch|label|queue|receive|variants)/", "destination": "/api/pack/[action]" },
    { "source": "/api/send-dispatch", "destination": "/api/design-lab/send-dispatch" },
    { "source": "/design-lab/r/:token", "destination": "/api/design-lab/share?t=:token" },
    { "source": "/design-lab/leaderboard", "destination": "/api/design-lab/leaderboard" },
    { "source": "/design-lab/leaderboard/", "destination": "/api/design-lab/leaderboard" },
    { "source": "/tools/compare", "destination": "/api/design-lab/compare" },
    { "source": "/tools/compare/", "destination": "/api/design-lab/compare" },
    { "source": "/tools/compare/:slug", "destination": "/api/design-lab/compare?slug=:slug" },
    { "source": "/compare/:slug", "destination": "/api/design-lab/compare?slug=:slug" },
    { "source": "/compare/:slug/", "destination": "/api/design-lab/compare?slug=:slug" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://veloxpeps.com/:path*",
      "permanent": true
    },
    {
      "source": "/compounds/neuropeptide-research/",
      "destination": "/compounds/cognitive/",
      "permanent": true
    },
    {
      "source": "/compounds/neuropeptide-research",
      "destination": "/compounds/cognitive/",
      "permanent": true
    },
    {
      "source": "/compounds/incretin-receptor-research/",
      "destination": "/compounds/metabolic/",
      "permanent": true
    },
    {
      "source": "/compounds/incretin-receptor-research",
      "destination": "/compounds/metabolic/",
      "permanent": true
    },
    {
      "source": "/compounds/angiogenic-tissue-research/",
      "destination": "/compounds/recovery/",
      "permanent": true
    },
    {
      "source": "/compounds/angiogenic-tissue-research",
      "destination": "/compounds/recovery/",
      "permanent": true
    },
    {
      "source": "/compounds/somatotropic-research/",
      "destination": "/compounds/growth/",
      "permanent": true
    },
    {
      "source": "/compounds/somatotropic-research",
      "destination": "/compounds/growth/",
      "permanent": true
    },
    {
      "source": "/compounds/oxidative-pathway-research/",
      "destination": "/compounds/antioxidant/",
      "permanent": true
    },
    {
      "source": "/compounds/oxidative-pathway-research",
      "destination": "/compounds/antioxidant/",
      "permanent": true
    },
    {
      "source": "/compounds/healing-and-repair/",
      "destination": "/compounds/recovery/",
      "permanent": true
    },
    {
